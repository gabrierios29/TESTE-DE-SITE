# Exemplo para homologação local com senha inicial inserida pelo operador.
CAP_ENV=test
CAP_HOST=127.0.0.1
CAP_PORT=4173
CAP_BASE_URL=http://127.0.0.1:4173
CAP_DATA_DIR=./data/homologacao
CAP_BACKUP_HOURS=24
CAP_BACKUP_COPIES=14
# CAP_ADMIN_EMAIL=administracao@example.invalid
# CAP_ADMIN_PASSWORD=
# CAP_ADMIN_OIDC_SUBJECT=

# Use origens HTTPS e os contratos de INTEGRACOES.md na homologação institucional.
# CAP_TLS_PROXY=1
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=
# SERVERS_API_URL=
# MOODLE_URL=
# MOODLE_TOKEN=
# MOODLE_CATEGORY_ID=
# MOODLE_STUDENT_ROLE_ID=
# CANAL_API_URL=
# EMAIL_API_URL=
INTEGRATION_AUTO_DISPATCH=false
